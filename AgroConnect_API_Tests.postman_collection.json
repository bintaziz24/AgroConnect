								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nom\": \"Arona\",\n  \"prenom\": \"Ndiaye\",\n  \"email\": \"arona@test.com\",\n  \"password\": \"password\",\n  \"password_confirmation\": \"password\",\n  \"role\": \"client\",\n  \"telephone\": \"771234567\"\n}"
